# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://meeple:meeple@localhost:5433/meeple_night?schema=public"

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
# Public origin of the app. Used for cookies, callbacks and invite links.
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Invite tokens
# ---------------------------------------------------------------------------
# Key used to encrypt invite tokens at rest (AES-256-GCM) so that an organizer
# can re-copy a link without the plaintext token being readable in the database.
# Generate with: openssl rand -base64 32
INVITE_ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key-for-invites="

# ---------------------------------------------------------------------------
# BoardGameGeek XML API2 (optional)
# ---------------------------------------------------------------------------
# Set BGG_ENABLED=false to run entirely offline with the bundled fixture
# provider. Manual game entry works in both modes.
BGG_ENABLED="true"
BGG_BASE_URL="https://boardgamegeek.com/xmlapi2"
# BGG's XML API2 does not require a key today. If your deployment fronts it with
# an authenticated proxy, put the credential here; it is only ever read on the
# server and is never sent to the browser.
BGG_API_TOKEN=""
# Contact string sent in the User-Agent, as BGG's terms request.
BGG_USER_AGENT="MeepleNight/0.1 (+https://example.com; contact@example.com)"
# Minimum milliseconds between outbound BGG requests (conservative throttle).
BGG_MIN_REQUEST_INTERVAL_MS="2000"
# Request timeout in milliseconds.
BGG_TIMEOUT_MS="15000"
# How long cached game metadata stays fresh, in hours.
BGG_CACHE_TTL_HOURS="168"
